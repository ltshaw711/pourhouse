# Copy to .env.local and fill in from your Supabase project settings.
# Never commit .env.local — it stays gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the email-confirmation / magic-link redirect URL. Update
# this to your real domain once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Used by import/admin edge functions — never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=
